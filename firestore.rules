rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Daniel (강시윤) is the admin
      return isSignedIn() && (request.auth.token.email == 'danielkangsy0328@gmail.com' || request.auth.uid == 'admin_daniel');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName']) &&
             data.keys().size() <= 6 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string;
    }

    function isValidSession(data) {
      return data.userId == request.auth.uid &&
             data.topic is string && data.topic.size() <= 5000 &&
             (data.keys().hasAll(['difficulty']) ? data.difficulty is string : true) &&
             (data.keys().hasAll(['mode']) ? data.mode in ['dialogue', 'debate'] : true) &&
             (data.keys().hasAll(['stance']) ? data.stance in ['pro', 'con'] : true);
    }

    function isValidMessage(data) {
      return data.role in ['user', 'model', 'assistant'] &&
             data.content is string && data.content.size() <= 60000;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /sessions/{sessionId} {
      allow create: if isSignedIn() && (sessionId.startsWith(request.auth.uid) || incoming().userId == request.auth.uid);
      allow get, list, update, delete: if isSignedIn() && (sessionId.startsWith(request.auth.uid) || (resource != null && resource.data.userId == request.auth.uid) || isAdmin());
    }

    match /conversations/{convId} {
      allow get: if isSignedIn() && (convId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (convId.matches('.*' + request.auth.uid + '.*') || isAdmin());
      }
    }
  }
}
